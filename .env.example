# Replace these placeholders with your development PostgreSQL connection details.
# Keep actual credentials in the ignored .env file, never in this example.
# Use your provider's TLS settings; verify-full verifies hosted database certificates.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full"

# Generate a private random application secret (at least 32 random bytes).
AUTH_SECRET=

# Google Cloud OAuth client: application type "Web application".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local canonical URL; register its /api/auth/callback/google URI in Google Cloud.
AUTH_URL="http://localhost:3000"
